{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bjcoombs/ai-native-toolkit/skills/assess/references/signals.schema.json",
  "title": "assess signals document",
  "description": "Output of skills/assess/scripts/assess_signals.py: a run stamp plus one block per scan. Generated from lib/run_context_types.py by lib/signals_schema.py.",
  "type": "object",
  "properties": {
    "signals_schema_version": {
      "type": "integer"
    },
    "stamp": {
      "type": "object",
      "properties": {
        "toolkit_commit": {
          "type": [
            "string",
            "null"
          ]
        },
        "plugin_version": {
          "type": "string"
        },
        "scan_date": {
          "type": "string"
        },
        "window": {
          "type": "string"
        },
        "target_head": {
          "type": [
            "string",
            "null"
          ]
        },
        "target_dirty": {
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "required": [
        "plugin_version",
        "scan_date",
        "target_dirty",
        "target_head",
        "toolkit_commit",
        "window"
      ],
      "additionalProperties": false
    },
    "scans": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "if": {
          "properties": {
            "available": {
              "const": false
            }
          },
          "required": [
            "available"
          ]
        },
        "then": {
          "properties": {
            "reason": {
              "type": "string",
              "description": "'code: sentence'; a counts-only document keeps the code only. The structure block's codes name the missing piece: no_grimp, no_networkx, grimp_failed, no_python_packages (a Python repository with no importable package), no_import_graph_<language> (no import graph for the dominant source language, for example no_import_graph_typescript) and no_source_files."
            }
          },
          "required": [
            "reason"
          ]
        }
      },
      "propertyNames": {
        "enum": [
          "accretion_ratchet",
          "agent_building",
          "agent_environment",
          "agent_harness",
          "agent_ops",
          "ai_usage",
          "ancestor_instruction_files",
          "archetype",
          "behaviour",
          "ci_checks",
          "claude_config",
          "config_drift",
          "coverage_gate",
          "coverage_report",
          "dead_code",
          "derived_findings",
          "diff",
          "doc_claims",
          "doc_graph",
          "doc_staleness",
          "documentation",
          "gap_actions",
          "gate_cost_estimate",
          "instruction_claims",
          "instruction_placement",
          "layer_grades",
          "nested_instructions",
          "observability",
          "promissory_markers",
          "review_reality",
          "runtime",
          "shared_tooling",
          "stats_summary",
          "structure",
          "structure_drift",
          "test_focus",
          "test_pressure",
          "understanding"
        ]
      }
    }
  },
  "required": [
    "scans",
    "signals_schema_version",
    "stamp"
  ],
  "additionalProperties": false
}
