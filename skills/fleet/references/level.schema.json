{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bjcoombs/ai-native-toolkit/skills/fleet/references/level.schema.json",
  "title": "fleet level results",
  "description": "level.json written by skills/fleet/scripts/fleet.py --levels: each scanned repository's conditions with their state and grade, the verified tally (counted conditions met, of those measured, and the conditions not measured with a reason) and its autonomy Step with what blocks the next, and under commits the HEAD sha it measured and whether the checkout was dirty. $defs.level_result is also the /assess run context's level block. Generated from lib/fleet/fleet_level.py and lib/level_result_types.py by lib/fleet/fleet_level_schema.py.",
  "type": "object",
  "properties": {
    "level_result_version": {
      "const": 4
    },
    "levels_version": {
      "type": "string"
    },
    "toolkit_commit": {
      "type": [
        "string",
        "null"
      ]
    },
    "plugin_version": {
      "type": "string"
    },
    "repos": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/level_result"
      }
    },
    "commits": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "head_sha": {
            "type": [
              "string",
              "null"
            ],
            "description": "the HEAD commit measured; null when the checkout has none"
          },
          "dirty": {
            "type": [
              "boolean",
              "null"
            ],
            "description": "true when tracked files differed from HEAD (untracked files and .assess/ outputs are left out, .assess/config.toml is not); the result is then scored from HEAD's committed tree. null when the state is unknown (repos.jsonl dirty_reason says why), and then a checkout with a HEAD was scored from its committed tree too"
          }
        },
        "required": [
          "dirty",
          "head_sha"
        ],
        "additionalProperties": false
      },
      "description": "the commit each repos entry measured, under the same ids"
    },
    "packs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "sha256": {
            "type": "string"
          },
          "repos": {
            "type": "integer"
          },
          "practices": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "condition": {
                  "type": "string"
                },
                "row": {
                  "type": "string"
                },
                "title": {
                  "type": "string"
                },
                "level": {
                  "type": "integer"
                },
                "met": {
                  "type": "integer"
                },
                "measured": {
                  "type": "integer"
                },
                "not_measured": {
                  "type": "integer"
                },
                "polarity": {
                  "enum": [
                    "hazard"
                  ]
                }
              },
              "required": [
                "condition",
                "level",
                "measured",
                "met",
                "not_measured",
                "row",
                "title"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "name",
          "practices",
          "repos",
          "sha256",
          "version"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "commits",
    "level_result_version",
    "levels_version",
    "plugin_version",
    "repos",
    "toolkit_commit"
  ],
  "additionalProperties": false,
  "$defs": {
    "level_result": {
      "type": "object",
      "properties": {
        "level_result_version": {
          "const": 4
        },
        "levels_version": {
          "type": "string"
        },
        "tally": {
          "type": "object",
          "properties": {
            "met": {
              "type": "integer"
            },
            "measured": {
              "type": "integer"
            },
            "not_measured": {
              "type": "integer"
            }
          },
          "required": [
            "measured",
            "met",
            "not_measured"
          ],
          "additionalProperties": false
        },
        "counted": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "listed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "not_measured": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "reason": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "reason"
            ],
            "additionalProperties": false
          }
        },
        "conditions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "row": {
                "type": "string"
              },
              "level": {
                "type": "integer"
              },
              "grade": {
                "enum": [
                  "config_only",
                  "declared",
                  "measured",
                  "verified",
                  null
                ]
              },
              "counted": {
                "type": "boolean",
                "description": "true when the grade is one of measured, verified, the owner did not exclude it and the fleet exit rule did not demote it (#1086)"
              },
              "state": {
                "enum": [
                  "met",
                  "unmet",
                  "not_applicable",
                  "not_measured",
                  "declined"
                ]
              },
              "reason": {
                "type": "string"
              },
              "disposition": {
                "enum": [
                  "excluded_by_owner",
                  "demoted_by_exit_rule"
                ]
              },
              "exclusion_kind": {
                "enum": [
                  "not_applicable",
                  "measured_elsewhere",
                  "tool_unsupported",
                  "false_positive",
                  "other"
                ]
              },
              "polarity": {
                "enum": [
                  "hazard"
                ],
                "description": "present only on a hazard condition, which is never counted (lib/levels_fields.py)"
              },
              "why": {
                "type": "string"
              },
              "source": {
                "type": "string",
                "description": "the base model or practice pack the row came from; present only when a pack added rows (lib/pack_layering.py)"
              }
            },
            "required": [
              "counted",
              "grade",
              "id",
              "level",
              "row",
              "state"
            ],
            "additionalProperties": false
          }
        },
        "step": {
          "type": [
            "integer",
            "null"
          ]
        },
        "next_step": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "step": {
                  "type": "integer"
                },
                "blockers": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "enum": [
                          "gate"
                        ]
                      },
                      "gate": {
                        "type": "string"
                      },
                      "condition": {
                        "type": "string"
                      },
                      "state": {
                        "type": "string"
                      },
                      "reason": {
                        "type": "string"
                      },
                      "disposition": {
                        "enum": [
                          "excluded_by_owner"
                        ]
                      },
                      "exclusion_kind": {
                        "enum": [
                          "not_applicable",
                          "measured_elsewhere",
                          "tool_unsupported",
                          "false_positive",
                          "other"
                        ]
                      }
                    },
                    "required": [
                      "kind"
                    ],
                    "additionalProperties": false
                  }
                }
              },
              "required": [
                "blockers",
                "step"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "excluded": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "kind": {
                "enum": [
                  "not_applicable",
                  "measured_elsewhere",
                  "tool_unsupported",
                  "false_positive",
                  "other"
                ]
              },
              "source": {
                "enum": [
                  "repo"
                ]
              }
            },
            "required": [
              "id",
              "kind",
              "source"
            ],
            "additionalProperties": false
          }
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "tag": {
                "enum": [
                  "behaviour",
                  "contracts",
                  "docs",
                  "structure",
                  "agent_context",
                  "agent_runtime",
                  "governance",
                  "supply_chain"
                ]
              },
              "conditions": {
                "type": "integer"
              },
              "countable": {
                "type": "integer"
              },
              "set_aside": {
                "type": "integer"
              },
              "met": {
                "type": "integer"
              },
              "measured": {
                "type": "integer"
              },
              "not_measured": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "reason": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "id",
                    "reason"
                  ],
                  "additionalProperties": false
                }
              },
              "countable_not_measured": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "reason": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "id",
                    "reason"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "conditions",
              "countable",
              "countable_not_measured",
              "measured",
              "met",
              "not_measured",
              "set_aside",
              "tag"
            ],
            "additionalProperties": false
          },
          "description": "one row per truth tag, every tag in this order (#940); met and measured are the headline strip's cells, and measured 0 means not measured, never a share of 0 (lib/level_tags.py)"
        }
      },
      "required": [
        "conditions",
        "counted",
        "level_result_version",
        "levels_version",
        "listed",
        "next_step",
        "not_measured",
        "step",
        "tally"
      ],
      "additionalProperties": false
    }
  }
}
