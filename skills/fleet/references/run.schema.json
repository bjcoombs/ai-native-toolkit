{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bjcoombs/ai-native-toolkit/skills/fleet/references/run.schema.json",
  "title": "fleet run stamp",
  "description": "run.json written by skills/fleet/scripts/fleet.py beside repos.jsonl: what produced the run and its repository counts. Generated from lib/fleet/fleet_stamp.py by lib/fleet/fleet_schema.py.",
  "type": "object",
  "properties": {
    "coverage": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "discoverable": {
              "type": "integer"
            },
            "assessed": {
              "type": "integer"
            },
            "archived_or_empty": {
              "type": "integer"
            },
            "not_cloned": {
              "type": "integer"
            },
            "failed_scan": {
              "type": "integer"
            },
            "excluded_by_filters": {
              "type": "integer"
            },
            "not_in_listing": {
              "type": "integer"
            }
          },
          "required": [
            "archived_or_empty",
            "assessed",
            "discoverable",
            "excluded_by_filters",
            "failed_scan",
            "not_cloned",
            "not_in_listing"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "fleet_stamp_version": {
      "type": "integer"
    },
    "toolkit_commit": {
      "type": [
        "string",
        "null"
      ]
    },
    "plugin_version": {
      "type": "string"
    },
    "scan_date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "window": {
      "type": "string",
      "pattern": "^[1-9][0-9]*(?:d|w|mo|y)$"
    },
    "levels_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "counts_only": {
      "type": "boolean"
    },
    "paths_hashed": {
      "type": "boolean"
    },
    "scans": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "fleet_config_sha256": {
      "type": [
        "string",
        "null"
      ]
    },
    "fleet_config_entries": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "ai_usage": {
              "type": "integer"
            },
            "review": {
              "type": "integer"
            },
            "platform": {
              "type": "integer"
            },
            "identities": {
              "type": "integer"
            }
          },
          "required": [
            "ai_usage",
            "identities",
            "platform",
            "review"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "platform": {
      "type": "boolean"
    },
    "repositories": {
      "type": "object",
      "properties": {
        "selected": {
          "type": "integer"
        },
        "scanned_ok": {
          "type": "integer"
        },
        "failed": {
          "type": "integer"
        },
        "qualifying": {
          "type": "integer"
        }
      },
      "required": [
        "failed",
        "qualifying",
        "scanned_ok",
        "selected"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "counts_only",
    "fleet_config_entries",
    "fleet_config_sha256",
    "fleet_stamp_version",
    "levels_version",
    "paths_hashed",
    "platform",
    "plugin_version",
    "repositories",
    "scan_date",
    "scans",
    "toolkit_commit",
    "window"
  ],
  "additionalProperties": false
}
