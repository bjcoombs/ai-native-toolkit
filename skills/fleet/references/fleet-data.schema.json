{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bjcoombs/ai-native-toolkit/skills/fleet/references/fleet-data.schema.json",
  "title": "fleet data bundle",
  "description": "fleet-data.json written by skills/fleet/scripts/fleet.py: the run stamp, the maturity model rows, the ownership and system unit trees with rolled-up levels, and per repository its units, web URL and per-row level, value and reason. Generated from lib/fleet/fleet_data.py by lib/fleet/fleet_data_schema.py.",
  "type": "object",
  "properties": {
    "fleet_data_version": {
      "const": 3
    },
    "run": {
      "type": "object",
      "properties": {
        "toolkit_commit": {
          "type": [
            "string",
            "null"
          ]
        },
        "plugin_version": {
          "type": "string"
        },
        "scan_date": {
          "type": "string"
        },
        "window": {
          "type": "string"
        },
        "levels_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "counts_only": {
          "type": "boolean"
        },
        "paths_hashed": {
          "type": "boolean"
        },
        "scans": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "fleet_config_sha256": {
          "type": [
            "string",
            "null"
          ]
        },
        "platform": {
          "type": "boolean"
        },
        "repositories": {
          "type": "object",
          "properties": {
            "selected": {
              "type": "integer"
            },
            "scanned_ok": {
              "type": "integer"
            },
            "failed": {
              "type": "integer"
            },
            "qualifying": {
              "type": "integer"
            }
          },
          "required": [
            "failed",
            "qualifying",
            "scanned_ok",
            "selected"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "counts_only",
        "fleet_config_sha256",
        "levels_version",
        "paths_hashed",
        "platform",
        "plugin_version",
        "repositories",
        "scan_date",
        "scans",
        "toolkit_commit",
        "window"
      ],
      "additionalProperties": false
    },
    "model": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "scope": {
            "enum": [
              "org",
              "team"
            ]
          },
          "top_level": {
            "type": "integer"
          }
        },
        "required": [
          "id",
          "scope",
          "title",
          "top_level"
        ],
        "additionalProperties": false
      }
    },
    "views": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "view": {
            "enum": [
              "ownership",
              "system"
            ]
          },
          "units": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "key": {
                  "type": "string"
                },
                "view": {
                  "enum": [
                    "ownership",
                    "system"
                  ]
                },
                "parent": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "kind": {
                  "enum": [
                    "org",
                    "division",
                    "department",
                    "team",
                    "system"
                  ]
                },
                "source": {
                  "enum": [
                    "path",
                    "github_teams",
                    "codeowners",
                    "mapping"
                  ]
                },
                "name": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "owners": {
                  "anyOf": [
                    {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "owner_count": {
                  "type": "integer"
                },
                "repos": {
                  "type": "integer"
                },
                "levels": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "row": {
                        "type": "string"
                      },
                      "measured": {
                        "type": "integer"
                      },
                      "repos": {
                        "type": "integer"
                      },
                      "lowest_level": {
                        "type": [
                          "integer",
                          "null"
                        ]
                      }
                    },
                    "required": [
                      "lowest_level",
                      "measured",
                      "repos",
                      "row"
                    ],
                    "additionalProperties": false
                  }
                }
              },
              "required": [
                "key",
                "kind",
                "levels",
                "name",
                "owner_count",
                "owners",
                "parent",
                "repos",
                "source",
                "view"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "units",
          "view"
        ],
        "additionalProperties": false
      }
    },
    "repos": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "reason": {
            "type": [
              "string",
              "null"
            ]
          },
          "active": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "web_url": {
            "type": [
              "string",
              "null"
            ]
          },
          "owners": {
            "anyOf": [
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "owner_count": {
            "type": "integer"
          },
          "units": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "view": {
                  "enum": [
                    "ownership",
                    "system"
                  ]
                },
                "unit": {
                  "type": "string"
                }
              },
              "required": [
                "unit",
                "view"
              ],
              "additionalProperties": false
            }
          },
          "rows": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "row": {
                  "type": "string"
                },
                "status": {
                  "enum": [
                    "level",
                    "unknown"
                  ]
                },
                "level": {
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "top_level": {
                  "type": "integer"
                },
                "signal": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "value": {
                  "type": [
                    "integer",
                    "number",
                    "boolean",
                    "string",
                    "null"
                  ]
                },
                "reason": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "required": [
                "level",
                "reason",
                "row",
                "signal",
                "status",
                "top_level",
                "value"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "active",
          "key",
          "owner_count",
          "owners",
          "reason",
          "rows",
          "status",
          "units",
          "web_url"
        ],
        "additionalProperties": false
      }
    },
    "opportunities": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "measured": {
              "type": "integer"
            },
            "in_place": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "row": {
                    "type": "string"
                  },
                  "at_top": {
                    "type": "integer"
                  },
                  "measured": {
                    "type": "integer"
                  }
                },
                "required": [
                  "at_top",
                  "measured",
                  "row"
                ],
                "additionalProperties": false
              }
            },
            "biggest_lift": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "row": {
                      "type": "string"
                    },
                    "level": {
                      "type": "integer"
                    },
                    "signal": {
                      "type": "string"
                    },
                    "repo_count": {
                      "type": "integer"
                    },
                    "repos": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "gate": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "step": {
                      "type": [
                        "integer",
                        "null"
                      ]
                    },
                    "change": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "done_when": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "text": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "change",
                    "done_when",
                    "gate",
                    "level",
                    "repo_count",
                    "repos",
                    "row",
                    "signal",
                    "step",
                    "text"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "null"
                }
              ]
            },
            "shared_templates": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "source": {
                    "type": "string"
                  },
                  "kind": {
                    "type": "string"
                  },
                  "includers": {
                    "type": "integer"
                  },
                  "row": {
                    "type": "string"
                  },
                  "level": {
                    "type": "integer"
                  },
                  "signal": {
                    "type": "string"
                  },
                  "repo_count": {
                    "type": "integer"
                  },
                  "repos": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "text": {
                    "type": "string"
                  }
                },
                "required": [
                  "includers",
                  "kind",
                  "level",
                  "repo_count",
                  "repos",
                  "row",
                  "signal",
                  "source",
                  "text"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "biggest_lift",
            "in_place",
            "measured",
            "shared_templates"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "fleet_data_version",
    "model",
    "opportunities",
    "repos",
    "run",
    "views"
  ],
  "additionalProperties": false
}
